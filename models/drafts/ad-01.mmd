flowchart TD
    start((开始))
    wait([等待玩家按键])
    valid{是否为有效移动}
    slide([滑动])
    merge([合并])
    score([计分])
    gen([随机生成方块])
    win{是否出现 2048}
    alive{是否还有可行移动}
    done((本局结束))

    start --> wait
    wait --> valid
    valid -->|有方块可滑动/合并| slide
    valid -->|无变化则不生成新方块| wait
    slide --> merge
    merge --> score
    score --> gen
    gen --> win
    win -->|是，棋盘出现 2048| done
    win -->|否，未出现 2048| alive
    alive -->|是，仍有可行移动| wait
    alive -->|否，棋盘已满且无法移动| done
